# Shrimp Gateway 核心运行时配置
PORT=8787
HOST=127.0.0.1

# 可选：对外网访问开放时的网关访问密钥（Bearer Token / x-api-key）
# 若设置，所有来自外部设备或穿透域名的客户端请求必须携带该 Key
# GATEWAY_API_KEY=your-custom-gateway-secret

# 可选：主配置文件路径（默认 gateway.config.json）
# GATEWAY_CONFIG_FILE=gateway.config.json

# 注意：
# 所有模型供应商（如火山方舟、Anthropic、OpenAI、DeepSeek、Grok 等）与网络搜索配置
# 已全面收归至 gateway.config.json 与 gateway.secrets.json 管理，无需在此配置环境变量。

# IM 会话投递 / Dify-compatible remote-agent bridge
# REMOTE_AGENT_TOKEN 用作 LangBot Dify Service API 的 API Key
# REMOTE_AGENT_TOKEN=remote-agent-secret
# 可选：Stage 2 完成回传 Webhook
# REMOTE_AGENT_WEBHOOK_URL=http://127.0.0.1:18080/hooks/shrimp
# open | confirm_dangerous | confirm_all
# REMOTE_AGENT_POLICY_MODE=confirm_dangerous
# 同步 Dify SSE 等待；Webhook 当前可选
# REMOTE_AGENT_SYNC_POLL_MS=2000
# REMOTE_AGENT_SYNC_HEARTBEAT_MS=15000
# REMOTE_AGENT_SYNC_MAX_WAIT_MS=180000

