{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "change-impact.schema.json",
  "title": "Business Knowledge Change Impact",
  "oneOf": [
    {"type": "object", "required": ["schema_version", "changed_facts", "affected_node_ids", "invalidated_node_ids"], "properties": {"schema_version": {"const": "1.0"}}},
    {"type": "object", "additionalProperties": false, "required": ["schema_version", "semantic_inputs", "validation_results"], "properties": {"schema_version": {"const": "2.0"}, "semantic_inputs": {"type": "object"}, "validation_results": {"type": "object"}}}
  ]
}
