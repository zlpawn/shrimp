{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "manifest.schema.json",
  "title": "Leo Code to Business Run Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "mode",
    "status",
    "repository_snapshot",
    "canonical_revision_sha256",
    "projection_hashes",
    "provider_observations",
    "coverage_status"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "mode": {
      "enum": [
        "build",
        "update",
        "query",
        "audit"
      ]
    },
    "status": {
      "enum": [
        "initialized",
        "snapshotted",
        "inventoried",
        "modeled",
        "audited",
        "projected",
        "evaluated",
        "reviewed",
        "passed",
        "partial",
        "blocked",
        "snapshot_failed",
        "inventory_failed",
        "model_failed",
        "audit_failed",
        "projection_failed",
        "evaluation_failed",
        "review_failed"
      ]
    },
    "repository_snapshot": {
      "type": "object"
    },
    "canonical_revision_sha256": {
      "type": [
        "string",
        "null"
      ]
    },
    "projection_hashes": {
      "type": "object"
    },
    "provider_observations": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "coverage_status": {
      "enum": [
        "passed",
        "partial",
        "blocked"
      ]
    }
  }
}
