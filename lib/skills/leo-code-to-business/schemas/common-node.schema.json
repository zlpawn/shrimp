{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "common-node.schema.json",
  "title": "Common Business Knowledge Node",
  "type": "object",
  "required": ["id", "title", "summary", "claim_status", "lifecycle_status", "confidence", "source_snapshot", "semantic_revision", "created_at", "updated_at"],
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "title": {"type": "string", "minLength": 1},
    "summary": {"type": "string", "minLength": 1},
    "claim_status": {"enum": ["confirmed", "inferred", "document_claim", "historical", "conflicted", "unknown"]},
    "lifecycle_status": {"enum": ["active", "conditional", "stale", "invalidated", "expired"]},
    "confidence": {"enum": ["E3", "E2", "E1", "E0"]},
    "source_snapshot": {"type": "string", "minLength": 1},
    "semantic_revision": {"type": "integer", "minimum": 1},
    "created_at": {"type": "string"},
    "updated_at": {"type": "string"}
  }
}
