{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "unknown.schema.json",
  "title": "Searched Business Unknown",
  "allOf": [{"$ref": "common-node.schema.json"}],
  "type": "object",
  "required": ["question", "importance", "reason", "search_status", "searched_evidence"],
  "properties": {
    "question": {"type": "string", "minLength": 1},
    "importance": {"enum": ["low", "medium", "high", "critical"]},
    "reason": {"type": "string", "minLength": 1},
    "search_status": {"const": "completed"},
    "searched_evidence": {"type": "array", "minItems": 1, "items": {"type": "string"}}
  }
}
