{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "inventory.schema.json",
  "title": "Repository Signal Inventory Item",
  "oneOf": [
    {
      "type": "object",
      "required": ["id", "kind", "name", "classification", "source_location", "resolution_status", "mapped_node_ids"],
      "properties": {"id_scheme": {"enum": ["legacy_v1", null]}}
    },
    {
      "type": "object",
      "additionalProperties": true,
      "required": ["id", "signal_class", "kind", "name", "source_location", "discovered_by", "structural_importance", "classification", "resolution_status", "mapped_node_ids", "resolution_reason", "snapshot_id", "id_scheme"],
      "properties": {
        "id": {"type": "string", "pattern": "^SIG-"},
        "signal_class": {"enum": ["trigger_entry", "mutation_anchor", "state_anchor", "external_effect_anchor", "event_anchor", "operational_anchor", "scenario_evidence"]},
        "kind": {"type": "string", "minLength": 1},
        "name": {"type": "string", "minLength": 1},
        "source_location": {"type": "object"},
        "discovered_by": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "structural_importance": {"enum": ["critical", "high", "normal", "low"]},
        "classification": {"type": "string"},
        "resolution_status": {"enum": ["resolved", "ambiguous", "unresolved", "excluded"]},
        "mapped_node_ids": {"type": "array", "items": {"type": "string"}},
        "resolution_reason": {"type": "string"},
        "snapshot_id": {"type": "string"},
        "id_scheme": {"const": "v2"},
        "non_candidate_status": {"enum": ["technical_support", "infrastructure", "duplicate_signal", "excluded_scope", "searched_non_business"]},
        "non_candidate_reason": {"type": "string"},
        "non_candidate_evidence_ids": {"type": "array", "items": {"type": "string"}}
      }
    }
  ]
}
