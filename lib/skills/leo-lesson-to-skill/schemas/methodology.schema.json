{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "methodology.schema.json",
  "title": "Extracted Course Methodology",
  "type": "object",
  "required": ["schema_version", "course_topic", "target_scenario", "frameworks", "steps", "principles", "templates", "anti_patterns", "uncertain_items"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "course_topic": {"type": "string", "minLength": 1},
    "target_scenario": {"type": "string", "minLength": 1},
    "frameworks": {"type": "array", "items": {"$ref": "#/$defs/evidenceItem"}},
    "steps": {"type": "array", "items": {"$ref": "#/$defs/evidenceItem"}},
    "principles": {"type": "array", "items": {"$ref": "#/$defs/evidenceItem"}},
    "templates": {"type": "array", "items": {"$ref": "#/$defs/evidenceItem"}},
    "anti_patterns": {"type": "array", "items": {"$ref": "#/$defs/evidenceItem"}},
    "uncertain_items": {"type": "array", "items": {"type": "object"}}
  },
  "$defs": {
    "evidenceItem": {
      "type": "object",
      "required": ["id", "source_refs", "evidence_type", "confidence", "conflict_status"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "source_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "evidence_type": {"enum": ["verbatim", "transcribed", "visual", "synthesized"]},
        "confidence": {"enum": ["high", "medium", "low"]},
        "conflict_status": {"enum": ["none", "open", "resolved_by_user"]}
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
