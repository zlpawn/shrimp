{
  "name": "leo-autodl-imagine-video",
  "version": "2.0.0",
  "description": "基于 AutoDL 云端旗舰 GPU 与 ComfyUI 的 MiniMax-H3 专属生图、多图编辑、分镜板与音画同步生视频技能，支持动态构建调整 ComfyUI 工作流与场景配方持续沉淀",
  "type": "module",
  "scripts": {
    "probe": "uv run scripts/client.py --probe --json",
    "power-on": "uv run scripts/client.py --power-on --json",
    "list-models": "uv run scripts/client.py --list-models --json",
    "list-workflows": "uv run scripts/client.py --list-remote-workflows --json"
  }
}
